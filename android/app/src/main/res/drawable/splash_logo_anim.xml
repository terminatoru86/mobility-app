<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own start (Android 12+): our big "m" in the middle, at the same size and place as on
     the start picture; its three dots light up one after another: red, yellow, green (our status
     colours). Then the start picture appears around it. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="108.42"
            android:viewportHeight="108.42">
            <group android:translateX="22.21" android:translateY="22.21">
                <path
                    android:pathData="M14,44 V28 A9,9 0 0 1 32,28 V44 M32,28 A9,9 0 0 1 50,28 V44"
                    android:strokeColor="#24333C"
                    android:strokeWidth="7.5"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
                <path android:name="red" android:fillAlpha="0" android:fillColor="#E0484D"
                    android:pathData="M9.4,54 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 z" />
                <path android:name="yellow" android:fillAlpha="0" android:fillColor="#E9A800"
                    android:pathData="M27.4,54 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 z" />
                <path android:name="green" android:fillAlpha="0" android:fillColor="#5D9A30"
                    android:pathData="M45.4,54 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="red">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:startOffset="80" android:duration="260" />
        </aapt:attr>
    </target>
    <target android:name="yellow">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:startOffset="360" android:duration="260" />
        </aapt:attr>
    </target>
    <target android:name="green">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:startOffset="640" android:duration="260" />
        </aapt:attr>
    </target>
</animated-vector>
