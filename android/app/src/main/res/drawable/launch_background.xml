<?xml version="1.0" encoding="utf-8"?>
<!-- while Android starts the app: our start picture itself (the same one Flutter then shows),
     so the city with MOBIlity is there at once, with no logo screen and no white -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><color android:color="#EEF2F2" /></item>
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_start" />
    </item>
</layer-list>
