<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: Android's own start allows only a colour and a round icon (no full picture).
         Like Lyft or Uber, we make it our brand: the light colour of our start picture and our big "m",
         whose dots light up red, yellow, green. The start picture then appears around the same logo. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#E8EDEF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo_anim</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
    <!-- while Flutter starts: the start picture itself -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
