<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: its own start screen is only a colour (Android allows no full picture there):
         the light grey of our start picture, with no icon and no logo -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#EEF2F2</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#EEF2F2</item>
    </style>
    <!-- while Flutter starts: the start picture itself -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
