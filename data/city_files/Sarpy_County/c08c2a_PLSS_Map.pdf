<script type="a2e0ccf4a72d6c5788dc6359-text/javascript">
    function filingsHelp() {
        alert('Select a Beginning and Ending Date to List All Filings in the Selected Date Range.');
    }

    function instHelp() {
        alert('The instrument Number is an unique number to identify a document. \n Enter 9 Digit Instrument Number \n (ex. 201399999 or 2013-99999)');
    }

    function grantorHelp() {
        alert('The Seller is Commonly Known as the Grantor. \n The Buyer is Commonly Known as the Grantee. \n Complete Names are not Required as the Search Will Return Records That Contain The Characters You Enter. \n Last Name Then First. \n Smith John \n Smith J \n Smith \n these are all valid');
    }

    function granteeHelp() {
        alert('The Buyer is Commonly Known as the Grantee. \n The Seller is Commonly Known as the Grantor. \n Complete Names are not Required as the Search Will Return Records That Contain The Characters You Enter. \n Last Name Then First.  \n Smith John \n Smith J \n Smith \n these are all valid');
    }

    function subSearchTypeHelp() {
        alert('Select either Acronym. Usually the first two letters of each word of the subdivision name \n or Subdivision Name to populate the Select drop down. \n the default is Acronym');
    }

    function subSearchHelp() {
        alert('a portion of land divided into lots for real-estate development \n Start typing an Acronym or Subdivision Name. You may skip this and pick directly from the Select Drop down ');
    }

    function lotHelp() {
        alert('A single lot within the selected subdivision. \n Enter a Lot \n (ex. 1)');
    }

    function blockHelp() {
        alert('Some subdivsions are laid out by a block of lots. \n Enter A Block \n (ex. 1)');
    }

    function landsHelp() {
        alert('Enter a Section,Township, and Range. Quarter Section Checks are Optional \n (ex. Section: 12 Township: 12 Range: 10  Optional Quarter Selectors. )');
    }

    function addressHelp() {
        alert('Enter an Address. (Type the Address Numbers and Wait for the Dropdown to Populate then Make Your Selection.) ');
    }

</script>
    
    <style type="text/css">

    .modalBackground

    {

        background-color: Black;

        /*filter: alpha(opacity=60);*/

        opacity: 0.6;

    }

    .modalPopup

    {

        background-color: #FFFFFF;

        width: 300px;

        border: 3px solid #0DA9D0;

        border-radius: 12px;

        padding: 0;

      z-index: 999999
       

    }

    .modalPopup .header

    {

        background-color: #2FBDF1;

        height: 30px;

        color: White;

        line-height: 30px;

        text-align: center;

        font-weight: bold;

        border-top-left-radius: 6px;

        border-top-right-radius: 6px;

    }

    .modalPopup .body

    {

        min-height: 50px;

        line-height: 30px;

        text-align: center;

        font-weight: bold;

    }

    .modalPopup .footer

    {

        padding: 6px;

    }

    .modalPopup .yes, .modalPopup .no

    {

        height: 23px;

        color: White;

        line-height: 23px;

        text-align: center;

        font-weight: bold;

        cursor: pointer;

        border-radius: 4px;

    }

    .modalPopup .yes

    {

        background-color: #2FBDF1;

        border: 1px solid #0DA9D0;

    }

    .modalPopup .no

    {

        background-color: #9F9F9F;

        border: 1px solid #5C5C5C;

    }
