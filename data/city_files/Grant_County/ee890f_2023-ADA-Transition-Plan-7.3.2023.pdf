  <script>
    document.addEventListener('DOMContentLoaded', function() {
        const slider = document.querySelector('#glide-sub-banners-9d87d08ca0');
        if (!slider) return;

        const slides = slider.querySelectorAll('.glide__slide');
        const slidesContainer = slider.querySelector('.glide__slides');
        const controls = slider.querySelector('.glide__controls');

        console.log('slides', slides)

        if(slides.length <= 4) {
        console.log('less than 4 slides')
            if (slidesContainer) slidesContainer.classList.add('no-glide');
            if (controls) controls.style.display = 'none';
        } else {
        console.log('more than 4 slides')
            new Glide('#glide-sub-banners-9d87d08ca0.glide-sub-banner', {
                peek: 0,
                perView: 4,
                type: "slider",
                breakpoints: {
                    1024: {
                        perView: 2
                    },
                    600: {
                        perView: 1
                    }
                }
            }).mount({ GlideCustomControls: GlideCustomControls });
        }
    });
  </script> 


