<div class="modal fade yt-gallery-modal" id="youtube-modal-60e6767fb8914600011dc0a53c924cbc" tabindex="-1" aria-label="YouTube video lightbox" aria-modal="true" role="dialog">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content bg-dark">
      <div class="modal-header border-0 p-2">
        <p class="yt-modal-title text-white mb-0 small me-auto"></p>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0 position-relative">
        <button class="btn btn-dark btn-lg yt-prev position-absolute top-50 start-0 translate-middle-y z-1 rounded-0" aria-label="Previous video">&#8249;</button>
        <div class="ratio ratio-16x9">
          <iframe class="yt-modal-iframe" src="" title="" allowfullscreen allow="autoplay; encrypted-media"></iframe>
        </div>
        <button class="btn btn-dark btn-lg yt-next position-absolute top-50 end-0 translate-middle-y z-1 rounded-0" aria-label="Next video">&#8250;</button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    function initYouTubeGalleries() {
      document.querySelectorAll('.yt-gallery-modal').forEach(function (modalEl) {
        if (modalEl.dataset.ytGalleryInit) return;
        modalEl.dataset.ytGalleryInit = '1';

        var currentIndex = 0;
        var galleryLinks = [];
        var iframe = modalEl.querySelector('.yt-modal-iframe');

        modalEl.addEventListener('show.bs.modal', function (event) {
          var trigger = event.relatedTarget;
          if (!trigger) return;
          var galleryId = trigger.getAttribute('data-gallery-id');
          galleryLinks = Array.from(document.querySelectorAll('[data-gallery-id="' + galleryId + '"]'));
          currentIndex = parseInt(trigger.getAttribute('data-index'), 10);
          loadVideo(currentIndex);
        });

        /* Stop playback when modal closes */
        modalEl.addEventListener('hide.bs.modal', function () {
          iframe.src = '';
        });

        function loadVideo(index) {
          var link = galleryLinks[index];
          if (!link) return;
          var videoId     = link.getAttribute('data-video-id');
          var videoParams = link.getAttribute('data-video-params') || '';
          var title       = link.getAttribute('data-title') || '';
          iframe.src = 'https://www.youtube.com/embed/' + videoId + '?' + videoParams;
          iframe.title = title;
          modalEl.querySelector('.yt-modal-title').textContent = title;
          modalEl.querySelector('.yt-prev').style.visibility = index === 0 ? 'hidden' : 'visible';
          modalEl.querySelector('.yt-next').style.visibility = index === galleryLinks.length - 1 ? 'hidden' : 'visible';
        }

        modalEl.querySelector('.yt-prev').addEventListener('click', function () {
          if (currentIndex > 0) { currentIndex--; loadVideo(currentIndex); }
        });

        modalEl.querySelector('.yt-next').addEventListener('click', function () {
          if (currentIndex < galleryLinks.length - 1) { currentIndex++; loadVideo(currentIndex); }
        });

        /* Keyboard navigation */
        modalEl.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowLeft') {
            if (currentIndex > 0) { currentIndex--; loadVideo(currentIndex); }
          } else if (event.key === 'ArrowRight') {
            if (currentIndex < galleryLinks.length - 1) { currentIndex++; loadVideo(currentIndex); }
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initYouTubeGalleries);
    } else {
      initYouTubeGalleries();
    }
  })();
</script>

