			</div>
		</div>
		<div class="cp-Splash-footer">
			<button class="cp-Splash-Btn cp-Splash-Btn--NoShow">Do Not Show Again</button>
			<button class="cp-Splash-Btn cp-Splash-Btn--Close">Close</button>
		</div>
	</div>
</div>

