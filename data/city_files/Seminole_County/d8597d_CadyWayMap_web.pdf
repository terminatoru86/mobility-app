<script language="javascript" type="text/javascript">

var srcserver = window.location.hostname.toLowerCase()
var tgtserver = ''

switch(srcserver)
{
case "interaspdev":
  tgtserver = "interDNNdv";
  break;
case  "interdotnetdev":
  tgtserver = "interDNNdv";
  break; 
case 'interasptest':
  tgtserver = 'interDNNtst' ;
  break;
 case 'interdotnettest':
  tgtserver = 'interDNNtst' ;
  break; 
case 'interasptrain':
  tgtserver = 'interDNNtrn' ;
  break;
case 'interdotnettrain':
  tgtserver = 'interDNNtrn' ;
  break;
case 'aspauthor':
  tgtserver = 'DNNauthor';
  break;  
case 'dotnetauth':
  tgtserver = 'DNNauthor' ;
  break;  
default:
  tgtserver = 'www.ocfl.net' ;
  break;
}

var servername = window.location.protocol + '//' +  tgtserver;
var urlpath = window.location.pathname;
var redirectto = servername + "/PageNotFound.aspx?aspxerrorpath=" + urlpath;
window.location = redirectto;

</script>

