.outages-safety-bpu-page .bpu-band__eyebrow {
 
    color: #ef800a !important;
   
}


section.bpu_need_assistance_section {
    background: linear-gradient(279.07deg, #B0D57B 0%, #376319 100%);
}

#gform_preview_13_6 span.gfield_fileupload_progressbar_progress{
    left: 0px !important;
}
div#gform_fields_13 .validation_message.gfield_validation_message {
    text-align: left;
}

.gform_confirmation_message_1 div {
  font-weight: 500 !important;
	margin-bottom: 15px !important;
}

div#file_8_19_name_display  img.emoji{
	height: 1.2em !important;
    width: 1.2em !important;
}

.gform_confirmation_message br {
  display: none !important;
}


.wp-block-cover, .wp-block-cover-image{
	padding:0px;
}

.gform_confirmation_message div b{
		font-weight: 800 !important;
}


.gform_confirmation_message div {
    margin: 10px 0px;
	font-weight:400 !important;
}

input#input_7_3, input#gform_submit_button_7 {
    height: 50px !important;
}

h2.gform_title {
    display: none;
}
/* .gform-theme--foundation .gform_fields {
        
        column-gap: 0px !important;
    } */
.subscribeabc input {
    border-radius: 0px !important;
    border-top-width: 1px !important;
    border-bottom-width: 1px !important;
    border-right-width: 0px !important;
    border-left-width: 1px !important;
    border-color: #ffffff !important;
}
input#gform_submit_button_7 {
    background-color: #7ca650;
    border-radius: 0;
}
.wp-container-core-group-is-layout-278fe766 > :where(:not(.alignleft):not(.alignright):not(.alignfull)) {
  
    font-weight: bolder;
}

.bpu-need-help__title, .bpu-need-help__text{
	margin:0px !important;
	padding:0px !important;
}

.otgs-development-site-front-end{
	display:none;
}


/** Home Banner **/

.feature-card-need_home {
    display: flex !important;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    align-content: center;
    text-align: center;
    padding: 60px 0;
}

.feature-card-need_home p.feature-card__text_home,
.feature-card-need_home p.feature-card__text {
    font-size: 18px;
    line-height: 28px;
    color: #fff;
    margin: 0px !important;
}

.feature-card-need_home h2.feature-card__title_home,
.feature-card-need_home .feature-card__title {
    color: #fff !important;
    font-size: 40px !important;
    font-weight: 700;
    line-height: 44px;
    margin: 0 !important;
}

.feature-card__media_home {
    margin-bottom: 20px;
}

.feature-card__body-need {
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: center;
    text-align: center;
}

.feature-card-need_home a.btn-solid {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Open Sans', sans-serif;
    font-weight: 700;
    font-size: 18px;
    line-height: 24px;
    padding: 14px 60px !important;
    border-radius: var(--r-sm);
    background: transparent !important;
    color: #fff !important;
    border: 2px solid #fff !important;
    text-decoration: none;
    text-align: center !important;
    margin: auto;
    transition: background .15s, color .15s;
}

.feature-card-need_home a.btn-solid:hover {
    background: #fff !important;
    color: #002b7f !important;
}


/* iPad / Tablet */
@media (min-width: 768px) and (max-width: 1024px) {
    .feature-card-need_home {
        padding: 40px 20px;
				width: 80%;
        margin: auto;
    }

    .feature-card-need_home h2.feature-card__title_home {
        width: 100% !important;
        font-size: 30px !important;
    }
}


/* Mobile */
@media (min-width: 360px) and (max-width: 767px) {
    .feature-card-need_home {
        padding: 40px 20px;
		
    
    }

    .feature-card-need_home h2.feature-card__title_home {
        width: 100% !important;
        font-size: 30px !important;
    }
	
	
	.feature-card-need_home p.feature-card__text_home,
.feature-card-need_home p.feature-card__text {
    font-size: 15px;
    line-height: 24px;
    color: #fff;
    margin: 0px !important;
}
	
	.feature-card__body-need{
		gap:12px !important
	}
	

}


/* Start css */

.beardcum-after-hero-img .pfc-hero__bc.wp-block-paragraph {
  margin: 30px auto !important;
 
}
.beardcum-after-hero-img .pfc-hero__bc.wp-block-paragraph a, .beardcum-after-hero-img .pfc-hero__bc.wp-block-paragraph  {
    color: #000;

}
