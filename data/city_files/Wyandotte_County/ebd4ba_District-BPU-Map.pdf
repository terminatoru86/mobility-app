         ========================================== -->

    <div
        id="gt_51559_translate"
        style="display:none;"
    ></div>


    <script>

    (function() {

        /*
         * ==========================================
         * VARIABLES
         * ==========================================
         */

        var selectId =
            'gt_51559_select';

        var translateId =
            'gt_51559_translate';

        var currentLang =
            "en";

        var sourceLang =
            "en";


        /*
         * ==========================================
         * GET COOKIE
         * ==========================================
         */

        function getCookie(name) {

            var match =
                document.cookie.match(
                    new RegExp(
                        '(?:^|; )' +
                        name.replace(
                            /([.$?*|{}()[\]\\/+^])/g,
                            '\\$1'
                        ) +
                        '=([^;]*)'
                    )
                );

            return match
                ? decodeURIComponent(match[1])
                : null;
        }


        /*
         * ==========================================
         * CLEAR GOOGLE TRANSLATE COOKIE
         * ==========================================
         */

        function clearGoogleCookie() {

            document.cookie =
                'googtrans=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT';

            /*
             * Also clear domain cookie
             */
            document.cookie =
                'googtrans=;path=/;domain=' +
                window.location.hostname +
