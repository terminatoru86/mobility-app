        }


        /*
         * ==========================================
         * SET GOOGLE TRANSLATE COOKIE
         * ==========================================
         */

        function setGoogleCookie(targetLang) {

            var value =
                '/' +
                sourceLang +
                '/' +
                targetLang;


            /*
             * One host cookie is normally enough.
             */
            document.cookie =
                'googtrans=' +
                value +
                ';path=/';


            /*
             * Domain cookie for compatibility.
             */
            document.cookie =
                'googtrans=' +
                value +
                ';path=/;domain=' +
                window.location.hostname;
        }


        /*
         * ==========================================
         * GET ACTIVE GOOGLE LANGUAGE
         * ==========================================
         */

        function getActiveGoogleLanguage() {

            var cookie =
                getCookie('googtrans');

            if (!cookie) {
                return null;
            }

            var parts =
                cookie.split('/');


            if (parts.length < 3) {
                return null;
            }


            /*
             * Make sure cookie belongs to
             * current WPML source language.
             */

            if (parts[1] !== sourceLang) {
                return null;
            }


            return parts[2] || null;
        }


        /*
         * ==========================================
         * SET SELECT VALUE
         * ==========================================
         */

        function setCurrentLanguage() {

            var select =
                document.getElementById(selectId);

            if (!select) {
                return;
            }


            var activeGoogle =
                getActiveGoogleLanguage();


            /*
             * Google Translate is active
             */

            if (activeGoogle) {

                var gtOption =
                    select.querySelector(
                        'option[data-type="gt"][value="' +
                        activeGoogle +
                        '"]'
                    );


                if (gtOption) {

                    select.value =
                        activeGoogle;

                    return;
                }
            }


            /*
             * WPML language
             */

            var wpmlOption =
                select.querySelector(
                    'option[data-type="wpml"][value="' +
                    currentLang +
                    '"]'
                );


            if (wpmlOption) {

                select.value =
                    currentLang;
            }
        }


        /*
         * ==========================================
         * LANGUAGE NAME FIX
         * ==========================================
         */

        function resetLanguageNames() {

            var select =
                document.getElementById(selectId);

            if (!select) {
                return;
            }


            var names = {

                en:
                    'English',

                es:
                    'Spanish',

                hmn:
                    'Hmong',

                my:
                    'Myanmar (Burmese)',

                ne:
                    'Nepali',

                sw:
                    'Swahili'
            };


            var options =
                select.querySelectorAll('option');


            options.forEach(
                function(option) {

                    if (
                        names[
                            option.value
                        ]
                    ) {

                        option.textContent =
                            names[
                                option.value
                            ];
                    }

                }
            );
        }


        /*
         * ==========================================
         * INITIALIZE SELECT
         * ==========================================
         */

        function initSwitcher() {

            var select =
                document.getElementById(selectId);

            if (!select) {
                return;
            }


            /*
             * Set language names immediately
             */
            resetLanguageNames();


            /*
             * Set current selected language
             */
            setCurrentLanguage();


            /*
             * ======================================
             * CHANGE EVENT
             * ======================================
             */

            select.addEventListener(
                'change',
                function() {

                    var option =
                        this.options[
                            this.selectedIndex
                        ];


                    if (!option) {
                        return;
                    }


                    var type =
                        option.getAttribute(
                            'data-type'
                        );


                    /*
                     * ==================================
                     * WPML
                     * ==================================
                     */

                    if (
                        type === 'wpml'
                    ) {

                        /*
                         * Remove Google translation
                         * immediately.
                         */
                        clearGoogleCookie();


                        var href =
                            option.getAttribute(
                                'data-href'
                            );


                        if (href) {

                            /*
                             * Direct redirect.
                             */
                            window.location.href =
                                href;
                        }


                        return;
                    }


                    /*
                     * ==================================
                     * GOOGLE TRANSLATE
                     * ==================================
                     */

                    if (
                        type === 'gt'
                    ) {

                        var targetLang =
                            this.value;


                        /*
                         * Set correct source/target
                         *
                         * EN -> NE
                         * /en/ne
                         *
                         * ES -> NE
                         * /es/ne
                         */
                        setGoogleCookie(
                            targetLang
                        );


                        /*
                         * Reload immediately.
                         */
                        window.location.reload();
                    }

                }
            );
        }


        /*
         * ==========================================
         * DOM READY
         * ==========================================
         */

        if (
            document.readyState ===
            'loading'
        ) {

            document.addEventListener(
                'DOMContentLoaded',
                initSwitcher
            );

        } else {

            initSwitcher();

        }


        /*
         * ==========================================
         * GOOGLE TRANSLATE INIT
         * ==========================================
         */

        window.googleTranslateElementInit =
            function() {

                if (
                    typeof google === 'undefined' ||
                    !google.translate
                ) {
                    return;
                }


                new google.translate.TranslateElement(

                    {

