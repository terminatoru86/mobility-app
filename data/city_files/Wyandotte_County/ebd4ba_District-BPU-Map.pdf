<script>
document.addEventListener('DOMContentLoaded', function () {

    // Only mobile + tablet
    if (window.innerWidth > 1080) {
        return;
    }

    const lang = document.documentElement.getAttribute('lang') || '';
    const cards = document.querySelectorAll('.mobil-click');

    cards.forEach(function (card, index) {

        let url = '';

        // English
        if (lang.toLowerCase().startsWith('en')) {

            if (index === 0) {
                url = '/help-center/programs-resources/weatherization/';
            } else if (index === 1) {
                url = '/billing-rates/payment-assistance/';
            }

        }

        // Spanish
        else if (lang.toLowerCase().startsWith('es')) {

            if (index === 0) {
                url = '/es/help-center/programs-resources/weatherization/';
            } else if (index === 1) {
                url = '/es/tarifas-de-facturacion/ayuda-para-el-pago/';
            }

        }

        // Make entire card clickable
        if (url) {

            card.style.cursor = 'pointer';

            card.addEventListener('click', function (e) {

                // If user clicks the existing Learn More button,
                // don't trigger the card click twice.
                if (e.target.closest('a')) {
                    return;
                }

                window.location.href = url;

            });
        }

    });

});
</script>


