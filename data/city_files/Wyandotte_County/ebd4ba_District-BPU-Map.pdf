<script>
jQuery(document).ready(function () {

    // Apply saved language class on page load
    let savedLang = localStorage.getItem('selectedLanguageClass');

    if (savedLang) {
        jQuery('body').addClass(savedLang);
    }

    jQuery('.gt_selector').on('change', function () {

        // Remove previous classes
        jQuery('body').removeClass(
            'spanish nepali hmong myanmar swahili'
        );

        localStorage.removeItem('selectedLanguageClass');

        let selectedValue = jQuery(this).val();

        // Default English
        if (!selectedValue || selectedValue === 'en|en') {
            return;
        }

        let langCode = selectedValue.split('|')[1];
        let bodyClass = '';

        switch (langCode) {

            case 'es':
                bodyClass = 'spanish';
                break;

            case 'ne':
                bodyClass = 'nepali';
                break;

            case 'hmn':
                bodyClass = 'hmong';
                break;

            case 'my':
                bodyClass = 'myanmar';
                break;

            case 'sw':
                bodyClass = 'swahili';
                break;
        }

        if (bodyClass !== '') {

            // Add class
            jQuery('body').addClass(bodyClass);

            // Save class for other pages
            localStorage.setItem(
                'selectedLanguageClass',
                bodyClass
            );
        }

    });

});
	
	
	
