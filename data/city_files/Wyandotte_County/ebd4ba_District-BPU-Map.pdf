<script>

// jQuery(function ($) {

//     jQuery('.bpu-acc').on('toggle', function () {

//         if ($(this).prop('open')) {
//             $('.bpu-acc').not(this).removeAttr('open');
//         }

//     });

// });

	jQuery(function ($) {

    var headerOffset = 100;   // sticky header ki height
    var speed = 500;          // ms, zyada = slow aur smooth
    var $items = $('.bpu-acc');

    $items.children('summary').on('click', function (e) {
        e.preventDefault();

        var $current = $(this).parent();
        var summary = this;

        // band karna ho to seedha band
        if ($current.prop('open')) {
            $current.removeAttr('open');
            return;
        }

        // 1) abhi ki page position
        var scrollBefore = window.pageYOffset;
        var topBefore = summary.getBoundingClientRect().top;

        // 2) baqi band karo, ye kholo (screen par abhi kuch nahi dikhta)
        $items.not($current).removeAttr('open');
        $current.attr('open', '');

        // 3) final position nikalo: band hone ke baad heading page mein kahan hai
        var docTop = summary.getBoundingClientRect().top + window.pageYOffset;
        var target = docTop - headerOffset;

        // 4) browser ne jo clamp kiya usay wapas wahin rakho jahan user tha
        window.scrollTo(0, scrollBefore);

        // 5) ab wahan se target tak ek hi smooth animation
        $('html, body').stop(true).animate({ scrollTop: target }, speed, 'swing');
    });

});
	
	

jQuery(function ($) {

    $('#news-search').on('keyup', function () {

        var value = $(this).val().toLowerCase();

        $('.bpu-acc__entry').each(function () {

            var title = $(this).find('a').text().toLowerCase();
            var date  = $(this).find('.bpu-date').text().toLowerCase();

            if (title.indexOf(value) > -1 || date.indexOf(value) > -1) {
                $(this).show();
            } else {
                $(this).hide();
            }

        });

    });

});

</script>

<script>
jQuery(document).ready(function ($) {

    $('.global-need-assignment__btn a.wp-block-button__link').each(function () {

        var $link = $(this);
        var currentHref = $link.attr('href') || '';

        // Only update Contact Us / Learn More links
        if (
            currentHref === '#' ||
            currentHref.indexOf('/contact-us.aspx') !== -1 ||
            currentHref.indexOf('/contact-us/') !== -1 ||
            $.trim($link.text()).toLowerCase() === 'learn more'
        ) {

            // Spanish WPML page
            if (window.location.pathname.indexOf('/es/') === 0) {
                $link.attr('href', '/es/contacta-con-nosotros/');
            }

            // English page
            else {
                $link.attr('href', '/contact-us/');
            }
        }

    });

});
	
	
	
jQuery(document).ready(function($) {
    $('.footer__small-links a').filter(function() {
        return $.trim($(this).text()) === 'Equal Opportunity Employer';
    }).contents().unwrap();
});

jQuery(document).ready(function($) {
    $('.footer__small-links a').filter(function() {
        return $.trim($(this).text()) === 'Empleador que ofrece igualdad de oportunidades';
    }).contents().unwrap();
});

	
	
	jQuery(document).ready(function ($) {
    $('a[href="https://myaccount.bpu.com/login.aspx"]').attr({
        'target': '_blank',
        'rel': 'noopener noreferrer'
    });
});
	
	
	
	jQuery(document).ready(function ($) {

    $('.footer__main a[href]').each(function () {

        var $link = $(this);
        var href = $link.attr('href');
        var text = $.trim($link.text());

        // Programar una cita → Calendly
        if (
            text.toLowerCase() === 'programar una cita' &&
            (!href || href === '#')
        ) {
            $link.attr(
                'href',
                'https://calendly.com/bpuinperson/in-person-appointment/'
            );

            $link.attr('target', '_blank');

            if (!$link.attr('rel')) {
                $link.attr('rel', 'noopener noreferrer');
            }

            return;
        }

        // Skip empty, hash and javascript links
        if (!href || href.charAt(0) === '#' || href.indexOf('javascript:') === 0) {
            return;
        }

        try {
            var linkUrl = new URL(href, window.location.href);

            // Only third-party/external links
            if (linkUrl.hostname !== window.location.hostname) {

                // Agar target already hai to leave karo
                if (!$link.attr('target')) {
                    $link.attr('target', '_blank');
                }

                // Agar rel already hai to leave karo
                if (!$link.attr('rel')) {
                    $link.attr('rel', 'noopener noreferrer');
                }
            }

        } catch (e) {
            // Invalid URL - ignore
        }
    });

});
	
	
	
	jQuery(document).ready(function ($) {
    // Spanish language page
    if ($('html').attr('lang') === 'es-ES' || $('html').attr('lang') === 'es') {
        $('.new-breadcrum-for-all a[href="/"]').each(function () {
            if ($(this).text().trim() === 'Inicio') {
                $(this).attr('href', '/es/');
            }
        });
    }
});

	
	
	
jQuery(document).ready(function () {

    jQuery('.mega-menu-col-links a[href*="Updated-Backflow-Test-Form.pdf"]')
        .attr('target', '_blank')
        .attr('rel', 'noopener noreferrer');

});










jQuery(function ($) {

    function setLanguageDropdown() {

        var htmlLang = $('html').attr('lang');

        if (!htmlLang) return;

        var lang = htmlLang.toLowerCase().split('-')[0];

        $('.lang-switcher select').each(function () {

            var $select = $(this);

            if ($select.val() !== lang) {
                $select.val(lang);
            }

            $select.find('option').each(function () {

                $(this).prop(
                    'selected',
                    $(this).val().toLowerCase() === lang
                );

            });

        });
    }

    setLanguageDropdown();

    $(window).on('load', setLanguageDropdown);

    setTimeout(setLanguageDropdown, 100);
    setTimeout(setLanguageDropdown, 500);
    setTimeout(setLanguageDropdown, 1000);

    // Watch for dynamically generated/replaced dropdown
    var observer = new MutationObserver(function () {
        setLanguageDropdown();
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });

});

jQuery(document).ready(function ($) {
		$('.new-target1 a').attr('target', '_blank');
	
	});
	
	jQuery(document).ready(function ($) {
    $('.site-header a[href]').each(function () {
        var $link = $(this);
        var href = $link.attr('href');

        if (!href || href.indexOf('#') === 0 || href.indexOf('javascript:') === 0) {
            return;
        }

        try {
            var url = new URL(href, window.location.origin);

            // Open only external/third-party links in a new tab
            if (url.hostname !== window.location.hostname) {
                $link.attr('target', '_blank');
                $link.attr('rel', 'noopener noreferrer');
            }
        } catch (e) {
            // Ignore invalid URLs
        }
    });
});

	
	

</script>


