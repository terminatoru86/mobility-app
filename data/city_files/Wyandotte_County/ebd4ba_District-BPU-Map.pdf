<style>
	
	.mobile-nav-wrapper{
    display:none;
}

	.mobile-menu,
.mobile-menu ul{
    list-style:none;
    margin:0;
    padding:0;
}

.mobile-menu li{
    border-bottom:1px solid #e5e5e5;
}
	
	span.arrow img

 {
    width: 20px;
    height: 20px;
}

.mobile-menu-item{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.mobile-menu-item a{
    flex:1;
    padding:12px 15px;
    text-decoration:none;
color: #002B7F;
    display: block;
    font-weight: 700;
    font-size: 18px;
}

.submenu-toggle{
    width:45px;
    border:none;
    background:none;
    cursor:pointer;
    font-size:14px;
}

.mobile-sub-menu{
    display:none;
    padding-left:20px;
}

.has-children.open > .mobile-sub-menu{
    display:block;
}
	
	ul.mobile-sub-menu {
    padding: 0px 00px 0 15px;
}

.arrow{
    display:inline-block;
    transition:0.3s;
}

.has-children.open > .mobile-menu-item .arrow{
    transform:rotate(180deg);
}
	
@media screen and (min-width: 360px) and (max-width: 1023px) {

    .desktop-nav{
        display:none;
    }

    .mobile-nav-wrapper{
        display:block;
    }
	
	.middle-header{
		padding: 15px 10px !important;
	}
	
	.mobile-top-strip {
        padding: 15px 15px 20px !important;
    }
	
	.lang-switcher select {
        padding: 5px 10px !important;
        /* width: 100px !important; */
    }

div#gform_fields_7 {
    display: flex;
	gap:0px;
}
	.new-breadcrum-for-all {
    margin: 20px 30px !important;
}
	
	.eventscalendar-bpu-page .bpu-formwrap {

