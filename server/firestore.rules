rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // the phones' areas are written only by the zoneLedger function (admin), never by the app directly
    match /devices/{id} {
      allow read, write: if false;
    }

    // opening hours and phone read by the app from a place's own website, shared by all riders:
    // anyone reads; only a signed-in rider adds or refreshes an entry, short texts only; no deleting
    match /site_info/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['url', 'hours', 'phone', 'checked'])
        && request.resource.data.url is string && request.resource.data.url.size() < 300
        && request.resource.data.hours is string && request.resource.data.hours.size() < 200
        && request.resource.data.phone is string && request.resource.data.phone.size() < 40
        && request.resource.data.checked is int;
    }
  }
}
