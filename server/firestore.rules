rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // the phones' areas are written only by the zoneLedger function (admin), never by the app directly
    match /devices/{id} {
      allow read, write: if false;
    }

    // The request to run a place's page: owner, business and EIN. PRIVATE: only the rider who sent it reads it
    // (and the MOBIlity team in the console). The team sets status to approved or rejected (+ note) there;
    // a rider can send it again only while it is pending or rejected, and can never change the status.
    match /shop_claims/{shop} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'placeKey', 'placeName', 'businessName', 'address', 'ownerName',
                                                 'phone', 'ein', 'status', 'note', 'at'])
        && request.resource.data.ein.size() == 11 && request.resource.data.ownerName.size() < 100;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status in ['pending', 'rejected']
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'placeKey', 'placeName', 'businessName', 'address', 'ownerName',
                                                 'phone', 'ein', 'status', 'note', 'at']);
    }

    // The page of a place, kept by its owner. Anyone reads. It can be created only by the rider whose request
    // (shop_claims, same id) we approved; only that owner changes it, and nobody can change `verified` from the app.
    match /shops/{shop} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && get(/databases/$(database)/documents/shop_claims/$(shop)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/shop_claims/$(shop)).data.status == 'approved'
        && request.resource.data.verified == true
        && request.resource.data.keys().hasOnly(['owner', 'verified', 'name', 'email', 'phone', 'hours', 'sells', 'photos',
                                                 'discount', 'discountText', 'discountOn', 'discountOther'])
        && request.resource.data.photos.size() <= 3;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.keys().hasOnly(['owner', 'verified', 'name', 'email', 'phone', 'hours', 'sells', 'photos',
                                                 'discount', 'discountText', 'discountOn', 'discountOther'])
        && request.resource.data.photos.size() <= 3;

      // "I was here": a rider adds himself once; only the shop owner can read the list (a count, no names shown)
      match /visits/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is int;
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/shops/$(shop)).data.owner == request.auth.uid;
      }

      // one message per month: the document is named after the month (UTC), written once, by the owner
      // of a verified shop. Riders who checked in read them.
      match /rewards/{month} {
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/shops/$(shop)).data.owner == request.auth.uid
          && get(/databases/$(database)/documents/shops/$(shop)).data.verified == true
          && month == string(request.time.year() * 100 + request.time.month())
          && request.resource.data.keys().hasOnly(['text', 'shop', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 200
          && request.resource.data.shop is string && request.resource.data.shop.size() < 120;
        allow read: if request.auth != null
          && (exists(/databases/$(database)/documents/shops/$(shop)/visits/$(request.auth.uid))
              || get(/databases/$(database)/documents/shops/$(shop)).data.owner == request.auth.uid);
      }
    }

    // opening hours and phone read by the app from a place's own website, shared by all riders:
    // anyone reads; only a signed-in rider adds or refreshes an entry, short texts only; no deleting
    match /site_info/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['url', 'hours', 'phone', 'checked'])
        && request.resource.data.url is string && request.resource.data.url.size() < 300
        && request.resource.data.hours is string && request.resource.data.hours.size() < 200
        && request.resource.data.phone is string && request.resource.data.phone.size() < 40
        && request.resource.data.checked is int;
    }
  }
}
